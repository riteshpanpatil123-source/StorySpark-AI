# StorySpark AI - Production Environment Configuration Example

# Frontend API Base URL (Safe for client)
VITE_API_BASE_URL=/api/v1

# Server Configuration (Server-only secrets)
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# AI Provider API Key (Server-side secret, NEVER use VITE_ prefix)
AI_API_KEY=your_gemini_or_openai_api_key_here
